{
  admin off
}

:5173 {
  log {
    output stdout
    format json
  }
  root * /srv
  encode gzip

  handle /v1/* {
    reverse_proxy backend:3000 {
      header_up Host {host}
    }
  }

  handle /health {
    reverse_proxy backend:3000
  }

  # Model Catalog Admin — static UI (khớp cả /admin và /admin/...)
  handle_path /admin* {
    root * /srv/admin-console
    @htmlAdmin path / *.html
    header @htmlAdmin Cache-Control "no-store, max-age=0"
    try_files {path} /index.html
    file_server
  }

handle {
    @static path / *.html *.js *.css
    header @static Cache-Control "no-store, max-age=0"
    try_files {path} /index.html
    file_server
  }
}
