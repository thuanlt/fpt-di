{
  admin off
}

:5173 {
  log {
    output stdout
    format json
  }
  root * /srv
  encode gzip

  handle /v1/* {
    reverse_proxy backend:3000 {
      header_up Host {host}
    }
  }

  handle /health {
    reverse_proxy backend:3000
  }

  handle {
    @html path / *.html
    header @html Cache-Control "no-store, max-age=0"
    try_files {path} /index.html
    file_server
  }
}
